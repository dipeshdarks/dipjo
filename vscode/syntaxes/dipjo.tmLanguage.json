{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/vscode-textmate/main/test-cases/schemas/tmlanguage.schema.json",
  "name": "Dipjo",
  "scopeName": "source.dipjo",
  "fileTypes": ["dipjo"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#database-methods" },
    { "include": "#builtin-functions" },
    { "include": "#keywords" },
    { "include": "#comparison-operators" },
    { "include": "#logical-operators" },
    { "include": "#arithmetic-operators" },
    { "include": "#function-definition" },
    { "include": "#function-call" },
    { "include": "#method-call" },
    { "include": "#variables" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.note.dipjo",
          "match": "^\\s*note\\b.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dipjo",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.dipjo" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.dipjo" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.dipjo",
              "match": "\\\\(?:[\"\\\\ntt])"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.dipjo",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.dipjo",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.dipjo",
          "match": "\\b(true)\\b"
        },
        {
          "name": "constant.language.boolean.false.dipjo",
          "match": "\\b(false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.dipjo",
          "match": "\\b(if|otherwise|finish\\s+condition)\\b"
        },
        {
          "name": "keyword.control.loop.dipjo",
          "match": "\\b(repeat|times|from|while|finish\\s+while|for|every|in|finish\\s+loop|finish\\s+repeat)\\b"
        },
        {
          "name": "keyword.control.function.dipjo",
          "match": "\\b(define|function|using|finish\\s+function|run|give\\s+back)\\b"
        },
        {
          "name": "keyword.declaration.dipjo",
          "match": "\\b(create|remember|set)\\b"
        },
        {
          "name": "keyword.other.dipjo",
          "match": "\\b(say|ask|and\\s+save\\s+in|put|into|remove|from|import)\\b"
        },
        {
          "name": "support.type.dipjo",
          "match": "\\b(number|text|truth)\\b"
        }
      ]
    },
    "comparison-operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.dipjo",
          "match": "\\bis\\s+not\\s+greater\\s+than\\b"
        },
        {
          "name": "keyword.operator.comparison.dipjo",
          "match": "\\bis\\s+not\\s+less\\s+than\\b"
        },
        {
          "name": "keyword.operator.comparison.dipjo",
          "match": "\\bis\\s+not\\s+equal\\s+to\\b"
        },
        {
          "name": "keyword.operator.comparison.dipjo",
          "match": "\\bis\\s+greater\\s+than\\s+or\\s+equal\\s+to\\b"
        },
        {
          "name": "keyword.operator.comparison.dipjo",
          "match": "\\bis\\s+less\\s+than\\s+or\\s+equal\\s+to\\b"
        },
        {
          "name": "keyword.operator.comparison.dipjo",
          "match": "\\bis\\s+greater\\s+than\\b"
        },
        {
          "name": "keyword.operator.comparison.dipjo",
          "match": "\\bis\\s+less\\s+than\\b"
        },
        {
          "name": "keyword.operator.comparison.dipjo",
          "match": "\\bis\\s+equal\\s+to\\b"
        },
        {
          "name": "keyword.operator.comparison.dipjo",
          "match": "\\bis\\b"
        }
      ]
    },
    "logical-operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.dipjo",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "arithmetic-operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.dipjo",
          "match": "\\b(plus|minus|times|divided\\s+by)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.shorthand.dipjo",
          "match": "\\b(add|subtract|multiply|divide|increase|decrease)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(define)\\s+(function)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "keyword.control.function.dipjo" },
            "2": { "name": "keyword.control.function.dipjo" },
            "3": { "name": "entity.name.function.dipjo" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b(run)\\s+(function)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "keyword.control.function.dipjo" },
            "2": { "name": "keyword.control.function.dipjo" },
            "3": { "name": "entity.name.function.dipjo" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(\\()",
          "captures": {
            "1": { "name": "entity.name.function.dipjo" },
            "2": { "name": "punctuation.definition.arguments.begin.dipjo" }
          }
        }
      ]
    },
    "method-call": {
      "patterns": [
        {
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(\\()",
          "captures": {
            "1": { "name": "support.function.database.dipjo" },
            "2": { "name": "punctuation.definition.arguments.begin.dipjo" }
          }
        },
        {
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "variable.other.property.dipjo" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.dipjo" },
            "2": { "name": "keyword.operator.assignment.dipjo" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.key.dipjo" },
            "2": { "name": "punctuation.separator.key-value.dipjo" }
          }
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.dipjo", "match": "\\." },
        { "name": "punctuation.separator.comma.dipjo", "match": "," },
        { "name": "punctuation.section.block.begin.dipjo", "match": "\\{" },
        { "name": "punctuation.section.block.end.dipjo", "match": "\\}" },
        { "name": "punctuation.section.parens.begin.dipjo", "match": "\\(" },
        { "name": "punctuation.section.parens.end.dipjo", "match": "\\)" },
        { "name": "punctuation.section.array.begin.dipjo", "match": "\\[" },
        { "name": "punctuation.section.array.end.dipjo", "match": "\\]" },
        { "name": "keyword.operator.assignment.dipjo", "match": "=" }
      ]
    }
  }
}

    "terminal.ansiBrightYellow": "#FBBF24",
    "terminal.ansiBrightBlue": "#38BDF8",
    "terminal.ansiBrightMagenta": "#C084FC",
    "terminal.ansiBrightCyan": "#22D3EE",
    "terminal.ansiBrightWhite": "#F8FAFC"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "comment.line.note.dipjo"],
      "settings": {
        "foreground": "#64748B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string.quoted.double.dipjo", "string"],
      "settings": {
        "foreground": "#5EEAD4"
      }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape.dipjo"],
      "settings": {
        "foreground": "#22D3EE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric.float.dipjo", "constant.numeric.integer.dipjo", "constant.numeric"],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "Booleans",
      "scope": ["constant.language.boolean.true.dipjo", "constant.language.boolean.false.dipjo", "constant.language.boolean"],
      "settings": {
        "foreground": "#F472B6"
      }
    },
    {
      "name": "Keywords - Conditional",
      "scope": ["keyword.control.conditional.dipjo"],
      "settings": {
        "foreground": "#A855F7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords - Loop",
      "scope": ["keyword.control.loop.dipjo"],
      "settings": {
        "foreground": "#A855F7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords - Function",
      "scope": ["keyword.control.function.dipjo"],
      "settings": {
        "foreground": "#A855F7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords - Declaration",
      "scope": ["keyword.declaration.dipjo"],
      "settings": {
        "foreground": "#A855F7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords - Other",
      "scope": ["keyword.other.dipjo"],
      "settings": {
        "foreground": "#A855F7"
      }
    },
    {
      "name": "Comparison operators",
      "scope": ["keyword.operator.comparison.dipjo"],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "name": "Logical operators",
      "scope": ["keyword.operator.logical.dipjo"],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "name": "Arithmetic operators",
      "scope": ["keyword.operator.arithmetic.dipjo", "keyword.operator.arithmetic.shorthand.dipjo"],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "name": "Assignment operator",
      "scope": ["keyword.operator.assignment.dipjo"],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "name": "Function names - definition and call",
      "scope": ["entity.name.function.dipjo"],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin.dipjo"],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "name": "Database methods",
      "scope": ["support.function.database.dipjo"],
      "settings": {
        "foreground": "#F0ABFC"
      }
    },
    {
      "name": "Type keywords",
      "scope": ["support.type.dipjo"],
      "settings": {
        "foreground": "#A855F7"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable.other.dipjo"],
      "settings": {
        "foreground": "#F8FAFC"
      }
    },
    {
      "name": "Dictionary keys",
      "scope": ["variable.other.key.dipjo"],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Object properties",
      "scope": ["variable.other.property.dipjo"],
      "settings": {
        "foreground": "#94A3B8"
      }
    },
    {
      "name": "Punctuation - terminators",
      "scope": ["punctuation.terminator.dipjo"],
      "settings": {
        "foreground": "#64748B"
      }
    },
    {
      "name": "Punctuation - separators",
      "scope": ["punctuation.separator.comma.dipjo", "punctuation.separator.key-value.dipjo"],
      "settings": {
        "foreground": "#64748B"
      }
    },
    {
      "name": "Punctuation - brackets",
      "scope": [
        "punctuation.section.block.begin.dipjo",
        "punctuation.section.block.end.dipjo",
        "punctuation.section.parens.begin.dipjo",
        "punctuation.section.parens.end.dipjo",
        "punctuation.section.array.begin.dipjo",
        "punctuation.section.array.end.dipjo"
      ],
      "settings": {
        "foreground": "#64748B"
      }
    },
    {
      "name": "String quotes",
      "scope": [
        "punctuation.definition.string.begin.dipjo",
        "punctuation.definition.string.end.dipjo"
      ],
      "settings": {
        "foreground": "#5EEAD4"
      }
    },
    {
      "name": "Function call parens",
      "scope": ["punctuation.definition.arguments.begin.dipjo"],
      "settings": {
        "foreground": "#38BDF8"
      }
    }
  ]
}
